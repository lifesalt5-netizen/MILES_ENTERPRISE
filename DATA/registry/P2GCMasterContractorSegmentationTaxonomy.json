{
  "version": "1.1.0",
  "name": "P2GC Master Contractor Segmentation Taxonomy",
  "architecture": "MULTI_DIMENSIONAL_NON_MUTUALLY_EXCLUSIVE",
  "scope": "FULL_CANONICAL_CONTRACTOR_UNIVERSE",
  "governingRules": {
    "noSilentOmissions": true,
    "companyIsDurableRevenueAsset": true,
    "contactIsReplaceableAttribute": true,
    "manySegmentsPerContractorAllowed": true,
    "onePrimaryOutboundCampaignPerCompany": true,
    "outboundIsQueryDrivenNotStaticCsvDriven": true,
    "unknownMustRemainDistinctFromZero": true,
    "everyMaterialClassificationRequiresEvidenceOrUnknown": true,
    "staleOrMissingContactCreatesEnrichmentWork": true,
    "suppressionMustNotBeBypassed": true,
    "awardHistoryLookbackIncludesCurrentFyPlusFivePriorFiscalYears": true,
    "historicalAwardeeRemainsCanonicalEvenWithoutCurrentFyActivity": true
  },
  "awardHistoryWindow": {
    "includedFiscalYears": [2021, 2022, 2023, 2024, 2025, 2026],
    "currentFiscalYearMayBePartial": true,
    "primeAndSubcontractEvidenceTrackedSeparately": true,
    "canonicalIdentityKey": "UEI"
  },
  "commercialDispositions": [
    "CONTACT_NOW",
    "HIGH_PRIORITY",
    "QUALIFIED",
    "NEEDS_ENRICHMENT",
    "WATCH_TRIGGER",
    "NURTURE",
    "EXISTING_CLIENT",
    "FORMER_CLIENT",
    "NO_CURRENT_FIT",
    "SUPPRESSED",
    "INACTIVE",
    "UNKNOWN_NOT_YET_EVALUATED"
  ],
  "governmentSalesBands": [
    {"id":"0","minInclusive":0,"maxInclusive":0},
    {"id":"lt_100k","minExclusive":0,"maxExclusive":100000},
    {"id":"100k_500k","minInclusive":100000,"maxExclusive":500000},
    {"id":"500k_1m","minInclusive":500000,"maxExclusive":1000000},
    {"id":"1m_3m","minInclusive":1000000,"maxExclusive":3000000},
    {"id":"3m_5m","minInclusive":3000000,"maxExclusive":5000000},
    {"id":"5m_10m","minInclusive":5000000,"maxExclusive":10000000},
    {"id":"10m_25m","minInclusive":10000000,"maxExclusive":25000000},
    {"id":"25m_50m","minInclusive":25000000,"maxExclusive":50000000},
    {"id":"50m_100m","minInclusive":50000000,"maxExclusive":100000000},
    {"id":"100m_plus","minInclusive":100000000,"maxExclusive":null}
  ],
  "dimensions": [
    {"id":"government_market_status","cardinality":"MULTI","values":["FEDERAL_ACTIVE","FEDERAL_HISTORICAL","SLED_ACTIVE","LOCAL_ACTIVE","NEW_TO_GOVERNMENT","UNKNOWN"]},
    {"id":"award_history","cardinality":"MULTI","values":["CURRENT_FY_AWARDED","HISTORICAL_AWARDED","NO_PROVEN_AWARD","UNKNOWN"]},
    {"id":"award_recency","cardinality":"ONE","values":["AWARD_CURRENT_FY","AWARD_PRIOR_1Y","AWARD_PRIOR_2Y","AWARD_PRIOR_3Y","AWARD_PRIOR_4Y","AWARD_PRIOR_5Y","NO_PROVEN_AWARD_IN_LOOKBACK","UNKNOWN"]},
    {"id":"award_active_fiscal_years","cardinality":"MULTI","values":["FY2021","FY2022","FY2023","FY2024","FY2025","FY2026","NONE_PROVEN","UNKNOWN"]},
    {"id":"award_role","cardinality":"MULTI","values":["PRIME","SUB","BOTH","NO_PROVEN_AWARD_ROLE","UNKNOWN"]},
    {"id":"government_sales_band","cardinality":"ONE_PER_MEASUREMENT_WINDOW","controlledBy":"governmentSalesBands"},
    {"id":"business_size","cardinality":"MULTI","values":["SMALL_BUSINESS","OTHER_THAN_SMALL","MICRO","UNKNOWN"]},
    {"id":"socioeconomic_certifications","cardinality":"MULTI","values":["8A","HUBZONE","WOSB","EDWOSB","SDVOSB","VOSB","SDB","NONE_PROVEN","UNKNOWN"]},
    {"id":"contract_vehicles","cardinality":"MULTI","values":["GSA_MAS","VA_FSS","SEWP","NITAAC","CHESS","OTHER_GWAC_IDIQ","NO_PROVEN_VEHICLE","UNKNOWN"]},
    {"id":"gsa_status","cardinality":"MULTI","values":["HOLDER","NON_HOLDER","NO_SALES","LOW_SALES","GROWTH","HIGH_GROWTH","EXPIRING","EXPIRED","UNKNOWN"]},
    {"id":"va_status","cardinality":"MULTI","values":["HOLDER","NON_HOLDER","NO_SALES","LOW_SALES","GROWTH","HIGH_GROWTH","EXPIRING","EXPIRED","UNKNOWN"]},
    {"id":"sled_status","cardinality":"MULTI","values":["ACTIVE","HISTORICAL","NET_NEW","UNKNOWN"]},
    {"id":"prime_sub_relationship","cardinality":"MULTI","values":["PRIME_ONLY","SUB_ONLY","BOTH","TEAMING_TARGET","TEAMING_PARTNER","UNKNOWN"]},
    {"id":"agency_relationships","cardinality":"MULTI","valueType":"AGENCY_ID_OR_NAME"},
    {"id":"buyer_relationships","cardinality":"MULTI","valueType":"BUYER_OR_OFFICE"},
    {"id":"geography","cardinality":"MULTI","valueType":"STATE_REGION_PLACE"},
    {"id":"industry_naics","cardinality":"MULTI","valueType":"NAICS"},
    {"id":"capabilities","cardinality":"MULTI","valueType":"CAPABILITY_TAG"},
