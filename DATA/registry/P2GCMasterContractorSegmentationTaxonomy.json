    {"id":"capture_maturity","cardinality":"ONE","values":["NOT_STARTED","EARLY","ACTIVE","ADVANCED","POSITIONED","UNKNOWN"]},
    {"id":"proposal_maturity","cardinality":"ONE","values":["NONE","PRE_RFP","RFP_ACTIVE","SUBMITTED","POST_SUBMISSION","UNKNOWN"]},
    {"id":"teaming_readiness","cardinality":"ONE","values":["READY","PARTIAL","NOT_READY","UNKNOWN"]},
    {"id":"prime_readiness","cardinality":"ONE","values":["READY","PARTIAL","NOT_READY","UNKNOWN"]},
    {"id":"subcontract_readiness","cardinality":"ONE","values":["READY","PARTIAL","NOT_READY","UNKNOWN"]},
    {"id":"financial_capacity","cardinality":"ONE","values":["STRONG","ADEQUATE","LIMITED","UNKNOWN"]},
    {"id":"sales_problem","cardinality":"MULTI","values":["NO_GOV_SALES","LOW_GOV_SALES","STALLED_GROWTH","VEHICLE_UNDERPERFORMANCE","PIPELINE_GAP","RECOMPETE_RISK","CONTACT_GAP","UNKNOWN"]},
    {"id":"trigger_signals","cardinality":"MULTI","values":["RECENT_AWARD","EXPIRING_AWARD","EXPIRING_VEHICLE","NEW_REGISTRATION","NEW_CERTIFICATION","HIRING_GROWTH","LEADERSHIP_CHANGE","NEW_OPPORTUNITY","BUYER_ACTIVITY","UNKNOWN"]},
    {"id":"buyer_persona","cardinality":"MULTI","values":["OWNER","CEO","PRESIDENT","COO","BUSINESS_DEVELOPMENT","FEDERAL_SALES","GOVERNMENT_SALES","CAPTURE","CONTRACTS","GROWTH","OTHER","UNKNOWN"]},
    {"id":"p2gc_service_fit","cardinality":"MULTI","values":["GSA_A_TO_Z","GSA_REMEDIATION","GSA_GROWTH","VA_FSS","CAPTURE","PROPOSAL_SUPPORT","SUB2PRIME","PRIME2SUB","TEAMING","SLED_GROWTH","FEDERAL_GROWTH_STRATEGY","ORION_INTELLIGENCE","OTHER","UNKNOWN"]},
    {"id":"crm_lifecycle","cardinality":"ONE","values":["NEW_ACCOUNT","PROSPECT","ENGAGED","MEETING","OPPORTUNITY","PROPOSAL","CLIENT","FORMER_CLIENT","DORMANT","UNKNOWN"]},
    {"id":"lead_temperature","cardinality":"ONE","values":["HOT","WARM","COOL","COLD","UNKNOWN"]},
    {"id":"contact_channel_readiness","cardinality":"MULTI","values":["VERIFIED_EMAIL","UNVERIFIED_EMAIL","PHONE","LINKEDIN","NO_CURRENT_CONTACT","SUPPRESSED_CONTACT","UNKNOWN"]},
    {"id":"enrichment_state","cardinality":"ONE","values":["COMPLETE","CONTACT_REQUIRED","CONTACT_VERIFICATION_REQUIRED","COMPANY_IDENTITY_REQUIRED","CAPABILITY_REQUIRED","VEHICLE_REQUIRED","AWARD_HISTORY_REQUIRED","UNKNOWN"]},
    {"id":"suppression_state","cardinality":"MULTI","values":["CLEAR","INDIVIDUAL_OPT_OUT","HARD_BOUNCE","INVALID_EMAIL","ACCOUNT_DO_NOT_PROSPECT","EXISTING_CLIENT_EXCLUSION","UNKNOWN"]},
    {"id":"historical_engagement","cardinality":"MULTI","values":["B12_SENT","B12_REPLIED","B12_MEETING","INSTANTLY_SENT","INSTANTLY_REPLIED","PAST_PROPOSAL","PAST_CLIENT","NONE_PROVEN","UNKNOWN"]}
  ],
  "requiredScores": [
    "FIT",
    "INTENT",
    "URGENCY",
    "VALUE",
    "CONTACTABILITY",
    "P2GC_SERVICE_MATCH",
    "OVERALL_REVENUE_PRIORITY"
  ],
