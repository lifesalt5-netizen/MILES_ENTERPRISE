{
  "version": "2.0.0",
  "name": "P2GC Awarded Contractor Account Segment Overlay",
  "purpose": "Overlay prime/subcontract award facts onto the multi-dimensional P2GC Master Contractor Segmentation Taxonomy while preserving one primary outbound campaign per company.",
  "taxonomyRegistry": "DATA/registry/P2GCMasterContractorSegmentationTaxonomy.json",
  "policy": {
    "canonicalAccountRequiredForEveryAwardedUei": true,
    "awardRoleAlwaysRetained": true,
    "multiDimensionalNonMutuallyExclusive": true,
    "retainExistingPrimaryRevenueSegmentWhenProven": true,
    "fallbackToAwardedAccountSegmentWhenNoExistingOutboundSegmentIsProven": true,
    "missingContactCreatesEnrichmentStateNotCompanyRemoval": true,
    "outboundPromotionRequiresVerifiedUnsuppressedContact": true,
    "onePrimaryCampaignPerCompany": true,
    "accountSegmentsAreNotAutomaticallyLiveCampaigns": true,
    "allSegmentTagsPersistWhenPrimaryOutboundCampaignChanges": true
  },
  "awardRoles": ["PRIME", "SUB", "BOTH"],
  "salesBandRegistry": [
    "0",
    "lt_100k",
    "100k_500k",
    "500k_1m",
    "1m_3m",
    "3m_5m",
    "5m_10m",
    "10m_25m",
    "25m_50m",
    "50m_100m",
    "100m_plus"
  ],
  "fallbackPrimaryOutboundPattern": "awarded_{award_role_lower}_{government_sales_band}",
  "requiredAwardTags": [
    "award_role:{PRIME|SUB|BOTH}",
    "government_sales_band:{band}",
    "award_history:CURRENT_FY_AWARDED"
  ],
  "lifecycleStates": [
    "OUTBOUND_READY",
    "CONTACT_VERIFICATION_REQUIRED",
    "CONTACT_ENRICHMENT_REQUIRED",
    "IDENTITY_ENRICHMENT_REQUIRED",
    "EXISTING_CLIENT",
    "DO_NOT_PROSPECT"
  ]
}
