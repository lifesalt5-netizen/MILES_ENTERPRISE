{
  "version": 3,
  "name": "MILES Production System Graph",
  "rule": "No production acceptance until source closure, machine prerequisites, runtime surfaces, provider truth, executable action capability, command preflight, command execution, business capabilities, and persistence all pass.",
  "protectedRuntimePaths": [
    ".git/",
    ".env",
    ".env.*",
    "DATA/",
    "logs/",
    "node_modules/"
  ],
  "governanceConfig": {
    "ceoGoals": "CONFIG/CEO_GOALS.json",
    "ceoApprovalRules": "CONFIG/CEO_APPROVAL_RULES.json",
    "ceoOperatingMission": "CONFIG/CEO_OPERATING_MISSION.json"
  },
  "surfaces": [
    {"name":"MILES API","pm2":"miles-api","entry":"SCRIPTS/StartMilesApi.js","port":3000,"health":"/"},
    {"name":"MILES Worker","pm2":"miles-worker","entry":"StartProductionSystem.js"},
    {"name":"Command Center","pm2":"miles-command-center","entry":"SERVICES/digital_coo/MilesCommandCenter.js","port":8787,"health":"/api/health"},
    {"name":"CEO Dashboard","pm2":"miles-executive-dashboard","entry":"StartExecutiveDashboard.js","port":8737,"health":"/api/state"},
    {"name":"Desktop UI","pm2":"miles-desktop-ui","entry":"StartMiles.js","port":3737,"health":"/api/status"},
    {"name":"Autonomous COO","pm2":"miles-autonomous-coo","entry":"StartAutonomousCOO.js"},
    {"name":"Prospect Blueprint","pm2":"p2gc-growth-demo","entry":"StartP2GCGrowthBlueprintDemo.js","port":8791,"health":"/api/health"},
    {"name":"Customer Delivery","pm2":"p2gc-customer-delivery","entry":"StartP2GCCustomerDelivery.js","port":8792,"health":"/api/health"},
    {"name":"Queue Maintainer","pm2":"miles-queue-maintainer","entry":"SCRIPTS/TaskQueueMaintenanceService.js"}
  ],
  "acceptanceRoots": [
    "SCRIPTS/TestMilesCoreHttpProbeP0.js",
    "SCRIPTS/RunMilesAcceptanceWithLiveMemory.js",
    "SCRIPTS/TestMilesProductionRecoveryAcceptanceP0.js",
    "SCRIPTS/TestMilesFinalSurfaceAcceptanceP0.js",
    "SCRIPTS/TestMilesRevenueConnectorAcceptanceP0.js",
    "SCRIPTS/TestP2GCWholeSystemAcceptanceP0.js",
    "SCRIPTS/TestP2GCCustomerDeliveryAcceptanceP0.js",
    "SCRIPTS/TestP2GCGrowthAssetsAcceptanceP0.js",
    "SCRIPTS/TestP2GCGrowthBlueprintDemoAcceptanceP0.js",
    "SCRIPTS/TestTaskQueueCompactionP0.js",
    "TESTS/TestProviderAuthorityEnvironmentP0.js",
    "TESTS/TestExecutionActionContractsP0.js",
    "TESTS/TestCommandPreflightP0.js"
  ],
  "staticAssets": [
    "SERVICES/ceo_dashboard/public/index.html",
    "SERVICES/ceo_dashboard/public/ceo.js",
    "SERVICES/ceo_dashboard/public/ceo.css",
    "SERVICES/demo/public/index.html",
    "SERVICES/demo/public/app.js",
    "SERVICES/demo/public/styles.css"
  ],
  "criticalModules": [
    "CORE/TaskQueue.js",
    "CORE/ExecutionActionContracts.js",
    "SERVICES/BusinessOperationsBridgeService.js",
    "SERVICES/governance/CommandPreflightService.js",
    "SERVICES/governance/ExecutionActionCapabilityService.js",
    "SERVICES/revenue/RevenueTruthGateService.js",
    "SERVICES/BusinessExecutionEngineServiceV2.js",
    "SERVICES/governance/PolicyEngineService.js",
    "SERVICES/ProviderAuthorityRegistryService.js",
    "SERVICES/ProviderRouterService.js",
    "SERVICES/WorkerBootstrap.js",
    "CONNECTORS/MILES/connector.js",
    "CONNECTORS/INSTANTLY/connector.js",
    "CONNECTORS/ORION/connector.js"
  ],
  "externalDependencies": [
    {"name":"Instantly","mode":"read-required/write-governed","credential":"INSTANTLY_API_KEY"},
    {"name":"ORION","mode":"read-required","data":"ORION_DB or ORION_DB_PATH"},
    {"name":"PM2","mode":"runtime-required"},
    {"name":"Node","mode":"runtime-required","major":24}
  ],
  "commandExecutionChain": [
    "CEO_INPUT",
    "INTENT_PARSE",
    "MISSION_PLAN",
    "NEGATION_AWARE_GOVERNANCE",
    "SOURCE_CLOSURE_PREFLIGHT",
    "CONNECTOR_PROVIDER_RESOLUTION",
    "ACTION_CAPABILITY_PREFLIGHT",
    "CREDENTIAL_AND_DATA_PREFLIGHT",
    "WORKER_RUNTIME_PREFLIGHT",
    "QUEUE_CAPACITY_AND_LOCK_PREFLIGHT",
    "BUSINESS_OPERATIONS_BRIDGE",
    "TASK_QUEUE",
    "EPHEMERAL_EXECUTOR",
    "CONNECTOR_OR_PROVIDER_EXECUTION",
    "PERSISTED_RESULT",
    "CEO_EVIDENCE"
  ],
  "releaseGates": [
    "SOURCE_CLOSURE",
    "MACHINE_PREREQUISITES",
    "DATA_AND_CONNECTORS",
    "PROCESS_RECONCILIATION",
    "HTTP_SURFACES",
    "PROVIDER_TRUTH",
    "ACTION_CAPABILITY_PREFLIGHT",
    "CEO_COMMAND_PREFLIGHT",
    "CEO_COMMAND_EXECUTION",
    "BUSINESS_CAPABILITIES",
    "PERSISTENCE_AND_SELF_HEAL"
  ]
}
