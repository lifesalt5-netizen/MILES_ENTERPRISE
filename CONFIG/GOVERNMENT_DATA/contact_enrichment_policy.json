{
  "policyId": "P2GC_GOVERNMENT_CONTACT_AUTHORITY",
  "version": "1.0.0",
  "effectiveDate": "2026-07-27",
  "purpose": "Require a verified deliverable business email for every retained company and prioritize the person with authority to purchase P2GC government-contracting services.",
  "requirements": {
    "verifiedDeliverableEmail": true,
    "exactSourcePublishedEmailRequired": true,
    "generatedOrInferredEmailAllowed": false,
    "emailPatternGuessingAllowed": false,
    "commercialDomainOnly": true,
    "sourceProvenanceRequired": true,
    "namedAuthorityPreferred": true,
    "genericMailboxFallbackAllowed": true,
    "genericMailboxMayOutrankNamedAuthority": false,
    "verificationDateRequiredForStaging": false,
    "verificationDateRequiredBeforeCampaignUpload": true,
    "maximumVerificationAgeDaysBeforeCampaignUpload": 90
  },
  "authorityTiers": [
