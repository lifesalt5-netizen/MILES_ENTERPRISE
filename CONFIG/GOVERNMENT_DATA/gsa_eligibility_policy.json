{
  "policyId": "P2GC_GSA_FEDERAL_MARKET_ELIGIBILITY",
  "version": "1.2.0",
  "mode": "STRICT",
  "effectiveDate": "2026-07-27",
  "purpose": "Prevent .org domains, records without verified deliverable email, non-government-buyable, nonprofit, consumer-only, non-target manufacturing, and unqualified microbusiness records from entering P2GC operational lead inventory.",
  "requirements": {
    "activeSamRegistration": true,
    "forProfitConfirmed": true,
    "qualifyingGsaNaicsOrSin": true,
    "notExcludedSuspendedOrDebarred": true,
    "federalCommercialReadinessConfirmed": true,
    "verifiedDeliverableEmail": true,
    "nonOrgEmailAndWebsiteDomain": true
  },
  "hardExcludedNaicsPrefixes": [
    "523",
    "721",
    "6111",
    "6112",
    "6113",
    "6114"
  ],
  "hardExcludedNaics": [
    "522292",
    "522310",
    "611511",
    "611512",
    "611519",
    "611610",
    "611620",
    "611630",
    "611691",
    "611692",
    "611699",
    "611710",
    "722330",
    "722410",
    "722511",
    "722513",
    "722515",
    "811192",
    "812111",
    "812112",
    "812113",
    "812199",
    "812910",
    "813110"
  ],
  "hardExcludedPatterns": [
    "\\bdog walk(er|ing)?\\b",
    "\\bpet sitt(er|ing)?\\b",
    "\\bpet groom(er|ing)?\\b",
    "\\bcar wash\\b",
    "\\bauto detail(ing|er)?\\b",
    "\\bfast[ -]?food\\b",
    "\\bfood truck\\b",
    "\\brestaurant\\b",
    "\\bnail salon\\b",
    "\\bhair salon\\b",
    "\\bbarber(shop)?\\b",
    "\\bmassage\\b",
    "\\bday spa\\b",
    "\\bchurch\\b",
    "\\bministry\\b",
    "\\breligious organization\\b",
    "\\bhotel\\b",
    "\\bmotel\\b",
    "\\bmortgage\\b",
    "\\binvestment (firm|company|advisor|adviser|management)\\b",
    "\\bday ?care\\b",
    "\\bpreschool\\b",
    "\\belementary school\\b",
    "\\bmiddle school\\b",
    "\\bhigh school\\b",
    "\\bcollege\\b",
    "\\buniversity\\b",
    "\\btattoo\\b"
  ],
  "nonprofitPatterns": [
    "\\bnon[ -]?profit\\b",
    "\\bnot for profit\\b",
    "\\bfoundation\\b",
    "\\breligious organization\\b",
    "\\bstate controlled institution of higher learning\\b",
    "\\bprivate university or college\\b"
  ],
  "acceptedScaleSignals": [
    "activeGsaContract",
    "federalAwardHistory",
    "positiveFederalRevenue",
    "institutionalDeliveryCapability",
    "commercialScaleEvidence",
    "confirmedB2BOrB2GOperations"
  ],
  "ambiguousTermsRequiringReview": [],
  "decisionRule": "Only ACTIVE, FOR-PROFIT, NON-EXCLUDED, NON-MANUFACTURING entities with no .org email or website domain, at least one VERIFIED DELIVERABLE EMAIL, an authoritative current GSA MAS NAICS or SIN match, and confirmed federal commercial readiness may enter operational inventory.",
  "downstreamRestrictions": {
    "rejectedMayEnterCanonicalInventory": false,
    "reviewRequiredMayEnterCanonicalInventory": false,
    "rejectedMayBeEnriched": false,
    "rejectedMayBeEmailVerified": false,
    "rejectedMayEnterCampaigns": false,
    "reviewRequiredMayEnterCampaigns": false,
    "campaignUploadsRequireKevinApproval": true,
    "recordsWithoutVerifiedEmailMayEnterCanonicalInventory": false,
    "recordsWithoutVerifiedEmailMayEnterSegments": false,
    "recordsWithoutVerifiedEmailMayEnterCampaigns": false,
    "orgDomainRecordsMayEnterCanonicalInventory": false,
    "orgDomainRecordsMayEnterSegments": false,
    "orgDomainRecordsMayEnterCampaigns": false
  },
  "manufacturingExclusion": {
    "enabled": true,
    "naicsPrefixes": [
      "31",
      "32",
      "33"
    ],
    "patterns": [
      "\\b(custom[ -]+)?manufactur(?:e|er|ing)\\b"
    ],
    "scope": "Exclude manufacturing and custom manufacturing. The word custom by itself is not an exclusion."
  },
  "disallowedTopLevelDomains": [
    ".org"
  ]
}
