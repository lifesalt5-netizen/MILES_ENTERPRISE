      {"step": 1, "dayOffset": 0, "purpose": "State/SLED relevance and revenue-growth opener"},
      {"step": 2, "dayOffset": 3, "purpose": "Follow-up with procurement positioning value"},
      {"step": 3, "dayOffset": 7, "purpose": "Opportunity/vehicle alignment follow-up"},
