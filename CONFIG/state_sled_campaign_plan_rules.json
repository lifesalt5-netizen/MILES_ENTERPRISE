    "doNotDeleteExistingPipelineCampaigns": true,
    "dedupeByEmail": true
  },
  "approval": {
    "campaignCreationRequiresApproval": true,
    "leadUploadRequiresApproval": true,
    "activationRequiresApproval": true,
    "senderAssignmentRequiresApproval": false,
    "sequenceCopyRequiresApproval": true
  },
  "safety": {
