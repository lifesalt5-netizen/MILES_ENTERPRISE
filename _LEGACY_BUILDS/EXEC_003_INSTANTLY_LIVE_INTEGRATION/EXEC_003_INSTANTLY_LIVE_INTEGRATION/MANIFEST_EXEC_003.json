{
  "build": "EXEC_003",
  "name": "Instantly Live Integration",
  "root": "D:\\P2GC_Intelligence\\MILES_OS",
  "services": [
    "InstantlyApiClient.js",
    "InstantlyLiveProviderController.js",
    "InstantlyActionBridgeService.js",
    "InstantlyLiveIntegrationService.js"
  ],
  "builderActions": [
    "INSTANTLY_LIVE",
    "INSTANTLY_HEALTH",
    "INSTANTLY_BRIDGE_ACTION"
  ],
  "outputs": [
    "DATA\\instantly_live\\instantly_live_state.json",
    "DATA\\instantly_live\\latest_instantly_live_run.json",
    "DATA\\instantly_live\\latest_health.json",
    "DATA\\instantly_live\\execution_history.json"
  ],
  "safety": {
    "writeOperationsRequire": "INSTANTLY_WRITE_ENABLED=true",
    "credentials": "INSTANTLY_API_KEY"
  }
}
